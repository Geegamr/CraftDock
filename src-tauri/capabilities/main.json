{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Allows the main window to invoke its narrow Rust commands and open only the fixed issue tracker URL.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/Geegamr/CraftDock/issues" }]
    }
  ]
}
