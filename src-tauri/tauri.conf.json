{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftDock",
  "version": "0.8.6",
  "identifier": "com.craftdock.launcher.tauri",
  "build": {
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node scripts/serve-tauri-renderer.js",
    "beforeBuildCommand": "node scripts/build-tauri-renderer.js",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CraftDock",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#080c14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon.ico"]
  }
}
