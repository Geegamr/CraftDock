# CraftDock environment variables
# Copy this file to .env for local development overrides

# Microsoft OAuth client ID
# Optional — defaults to the public Minecraft client ID
# MS_CLIENT_ID=00000000402b5328

# CurseForge API key
# Development reads it at runtime; packaged builds embed it at build time
# (Electron via scripts/embed-cf-key.js, the Tauri exe via src-tauri/build.rs),
# so distributed copies work without shipping this file.
# CF_API_KEY=your_key_here
