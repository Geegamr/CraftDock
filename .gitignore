# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
out/
build/
rust/target/
src-tauri/target/

# ── Environment / Secrets ─────────────────────────────────────
.env
# Embedded at build time from .env by scripts/embed-cf-key.js
cf-key.js
# .env.example is intentionally NOT ignored (safe to commit)

# ── User data ─────────────────────────────────────────────────
# CraftDock stores instances, servers, accounts, and tokens here
craftdock-data/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor files ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Electron cache ────────────────────────────────────────────
.electron-cache/
*.bat
main.js.bak

# ── Local tooling / session artifacts ─────────────────────────
.local-tauri-cli/
.cloud-attachments/
