{
  "name": "craftdock",
  "version": "0.6.3",
  "description": "CraftDock \u2014 A lightweight Minecraft launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:native": "cargo build --manifest-path rust/Cargo.toml --release",
    "build:win": "npm run build:native && electron-builder --win",
    "build:mac": "npm run build:native && electron-builder --mac",
    "build:linux": "npm run build:native && electron-builder --linux",
    "clean": "rmdir /s /q dist 2>nul & echo cleaned"
  },
  "build": {
    "appId": "com.craftdock.launcher",
    "productName": "CraftDock",
    "copyright": "Copyright \u00a9 2025 CraftDock",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "rust/target/release",
        "to": "native",
        "filter": ["craftdock-servers-dat", "craftdock-servers-dat.exe", "craftdock-server-jar-list", "craftdock-server-jar-list.exe", "craftdock-screenshot-list", "craftdock-screenshot-list.exe", "craftdock-config-file-list", "craftdock-config-file-list.exe", "craftdock-server-properties", "craftdock-server-properties.exe", "craftdock-instance-world-list", "craftdock-instance-world-list.exe", "craftdock-server-json", "craftdock-server-json.exe", "craftdock-modpack-metadata", "craftdock-modpack-metadata.exe", "craftdock-instance-mod-toggle", "craftdock-instance-mod-toggle.exe", "craftdock-skin-library", "craftdock-skin-library.exe"]
      }
    ],
    "files": [
      "main.js",
      "servers-dat.js",
      "server-jar-list.js",
      "screenshot-list.js",
      "config-file-list.js",
      "server-properties.js",
      "instance-world-list.js",
      "server-json.js",
      "modpack-metadata.js",
      "instance-mod-toggle.js",
      "skin-library.js",
      "preload.js",
      "console-preload.js",
      "src/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "minecraft",
    "launcher",
    "modpack"
  ],
  "author": "CraftDock Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  }
}
